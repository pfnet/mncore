+def multidim_indexing(tensor, idx, assign=None):
+    if tensor.ndim == 2:
+        num_cols = tensor.shape[1]
+        flat_indices = idx[0] * num_cols + idx[1]
+        if assign is not None:
+            tensor.view(-1)[flat_indices] = assign
+            return tensor
+        else:
+            return tensor.view(-1)[flat_indices]
+    elif tensor.ndim == 3:
+        num_cols = tensor.shape[1]
+        flat_indices = idx[0] * num_cols + idx[1]
+        if assign is not None:
+            tensor.reshape(-1, tensor.shape[2])[flat_indices] = assign
+            return tensor
+        else:
+            return tensor.reshape(-1, tensor.shape[2])[flat_indices]
+
